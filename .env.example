# --- Identidad: Microsoft Entra External ID -----------------------------------
VITE_AZURE_TENANT_TYPE=ciam
VITE_AZURE_CLIENT_ID=
VITE_AZURE_TENANT_ID=
VITE_AZURE_TENANT_SUBDOMAIN=
VITE_REDIRECT_URI=http://localhost:5173

# --- API de productos (heredado) ----------------------------------------------
VITE_API_BASE_URL=http://localhost:8081/api
VITE_API_SCOPE=

# --- Microservicios de la mensajeria ------------------------------------------
VITE_MS_PRODUCTOS=http://localhost:8081
VITE_MS_PEDIDOS=http://localhost:8082
VITE_MS_NOTIFICACIONES=http://localhost:8083
VITE_MS_ADMIN_RABBIT=http://localhost:8084

# --- Microservicio de Kafka ---------------------------------------------------
# Expone dos grupos de endpoints, todos publicos (no requieren token):
#   /api/kafka        laboratorio: publicar, ver lo consumido, topic y grupo
#   /api/kafka/admin  administracion: brokers, crear / modificar / eliminar
#                     topics, y grupos consumidores con su retraso
VITE_MS_KAFKA=http://localhost:8888

# Scopes separados por coma: lectura y escritura
VITE_API_SCOPES=

# =============================================================================
# DESPLIEGUE EN LA NUBE
# -----------------------------------------------------------------------------
# Para el entorno desplegado se crea un archivo .env.production con estos mismos
# nombres, pero apuntando al API Manager en vez de a cada microservicio. Vite
# incrusta los valores al compilar, de modo que el archivo debe estar completo
# antes de ejecutar el build.
#
#   VITE_REDIRECT_URI=https://DOMINIO.cloudfront.net/
#   VITE_API_BASE_URL=https://ID.execute-api.us-east-1.amazonaws.com/productos/api
#   VITE_MS_PRODUCTOS=https://ID.execute-api.us-east-1.amazonaws.com/productos
#   VITE_MS_PEDIDOS=https://ID.execute-api.us-east-1.amazonaws.com/pedidos
#   VITE_MS_NOTIFICACIONES=https://ID.execute-api.us-east-1.amazonaws.com/notificaciones
#   VITE_MS_ADMIN_RABBIT=https://ID.execute-api.us-east-1.amazonaws.com/admin-rabbit
#   VITE_MS_KAFKA=https://ID.execute-api.us-east-1.amazonaws.com/kafka
#
# La direccion de redireccion tiene que estar registrada en el tenant antes de
# compilar: el proveedor de identidad solo acepta https, salvo localhost.
# =============================================================================
